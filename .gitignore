# ESP-IDF build output (HA profile builds into build/, Direct profile into build-direct/)
build/
build-*/
managed_components/
sdkconfig.old
*.o
*.elf
*.bin
*.map
compile_commands.json
*.pyc
__pycache__/

# Web UI staging (generated by tools/stage_www.py during the build)
frontend/dist/
frontend/direct/dist/
www/
www-direct/
dist/

# Signing keys — never commit. tools/signing_key.sh creates a local development key on first build.
*.pem
*_key.bin
secure_boot_signing_key*

# Logs written by the factory / flashing tools
tools/.factory_identity_log.csv
tools/.factory_test_log.csv
mg24_flash_log.csv

# Editors / OS
.vscode/
.idea/
.clangd
.clangd/
.ccls-cache/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
